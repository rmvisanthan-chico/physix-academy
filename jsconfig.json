{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["js/**/*", "tests/**/*"],
  "exclude": [
    "js/vendor/**",
    "node_modules/**",
    "dist/**",
    "electron/**",
    "astra/**",
    "html5-sims/**",
    "tools/**"
  ]
}
